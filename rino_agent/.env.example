# Generate with: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
RINO_AGENT_API_TOKEN=
# Optional. If omitted, the API token is used as the audit-chain HMAC key.
RINO_AGENT_AUDIT_KEY=

# Set true only after all placeholders below have been configured.
RINO_IMAGE_GENERATION_ENABLED=false
# API workflow JSON and the node/input where a caller's prompt is inserted.
RINO_IMAGE_WORKFLOW=
RINO_IMAGE_PROMPT_NODE=
RINO_IMAGE_PROMPT_INPUT=
# ComfyUI endpoint, output root, and a SillyTavern-served output directory/URL prefix.
RINO_IMAGE_COMFYUI_URL=
RINO_IMAGE_KOBOLD_URL=
RINO_IMAGE_COMFYUI_OUTPUT_DIR=
RINO_IMAGE_PUBLIC_OUTPUT_DIR=
RINO_IMAGE_PUBLIC_URL_PREFIX=
# Fixed executable names and JSON-array launch commands. No caller can supply commands.
RINO_IMAGE_KOBOLD_PROCESS=
RINO_IMAGE_KOBOLD_START=[]
RINO_IMAGE_COMFYUI_START=[]
